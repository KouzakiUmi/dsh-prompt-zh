{
  "name": "dsh-prompt-zh",
  "version": "1.2.6",
  "displayName": "系统提示词中文化",
  "description": "中文化 DSH 已知的系统提示词、MCP 指导与运行时提醒；按可见工具裁剪规则，保留工具 description、参数 schema 与动态值。纯 Host 插件，无 UI。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "i18n",
    "localization",
    "chinese",
    "prompt"
  ],
  "license": "MIT",
  "icon": "./icon.svg",
  "type": "module",
  "main": "./lib/index.js",
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "icon.svg",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "docs",
    "assets"
  ],
  "scripts": {
    "test": "node tests/check.mjs",
    "check": "node tests/check.mjs && node scripts/check-manifest.mjs"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "node": ">=18",
      "dshReleases": {
        "0.2.0-rc.1": "compatible",
        "0.2.0-rc.2": "compatible",
        "0.2.1-alpha.1": "compatible",
        "0.2.1-alpha.2": "compatible"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KouzakiUmi/dsh-prompt-zh.git"
  },
  "homepage": "https://github.com/KouzakiUmi/dsh-prompt-zh#readme",
  "bugs": {
    "url": "https://github.com/KouzakiUmi/dsh-prompt-zh/issues"
  }
}
