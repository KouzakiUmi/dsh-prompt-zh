{
  "name": "dsh-prompt-zh",
  "version": "1.3.1",
  "displayName": "系统提示词中文化",
  "description": "中文化 DSH 已知提示词；原生设置页逐条编辑译文、组件开关、精确版本门控及匹配诊断，按 Profile 保存。保留工具名、参数结构与动态值。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "i18n",
    "localization",
    "chinese",
    "prompt"
  ],
  "license": "MIT",
  "icon": "./icon.svg",
  "type": "module",
  "main": "./lib/index.js",
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "icon.svg",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "docs",
    "assets"
  ],
  "peerDependencies": {
    "@deepseek-ai/schemastery": "~3.18.5-alpha.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node tests/check.mjs",
    "check": "node tests/check.mjs && node scripts/check-manifest.mjs"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "node": ">=18",
      "dshReleases": {
        "0.2.1-alpha.2": "compatible",
        "0.2.1-alpha.3": "compatible"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KouzakiUmi/dsh-prompt-zh.git"
  },
  "homepage": "https://github.com/KouzakiUmi/dsh-prompt-zh#readme",
  "bugs": {
    "url": "https://github.com/KouzakiUmi/dsh-prompt-zh/issues"
  }
}
